# Copy this file to `.env` (same folder) and fill it in. `.env` is gitignored - never commit real keys.

# Optional: enables the LLM-powered AI copilot. Without it the app uses its built-in
# rule-based agent and everything else still works. Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=

# Optional: override the model (defaults to nvidia/llama-3.1-nemotron-70b-instruct)
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
